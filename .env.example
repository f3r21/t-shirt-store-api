# Working local values. `cp .env.example .env` boots against `npm run docker:up`.
# Only JWT_SECRET and REFRESH_TOKEN_PEPPER are blank, because they are secrets.
# Both need at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

NODE_ENV=development
PORT=3000

# Postgres is published on 5433, not 5432. The compose file avoids a clash with
# the container from week 1.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/tshirt_store
REDIS_URL=redis://localhost:6379

JWT_SECRET=
REFRESH_TOKEN_PEPPER=

# Seconds. 900 is 15 minutes, 604800 is 7 days.
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
REFRESH_ABSOLUTE_TTL_DAYS=30

# Seconds here. The throttler reads milliseconds, so the module wraps this value
# in its own `seconds()` helper rather than passing it through.
#
# THROTTLE_LIMIT is the browse tier, and it is deliberately loose. Sign-in and the
# three password operations carry their own tighter limits through `@Throttle`,
# so lowering this number does not tighten them.
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Mailpit, from the compose file. Its web interface is on 8025.
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@tshirt.store

# Where a password reset link points. The mailer builds every reset URL against
# this value.
APP_URL=http://localhost:3000
