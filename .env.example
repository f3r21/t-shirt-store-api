# Working local values. `cp .env.example .env` boots against `npm run docker:up`.
# Only JWT_SECRET and REFRESH_TOKEN_PEPPER are blank, because they are secrets.
# Both need at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# A key with nothing after the `=` reads as absent, not as zero or as an empty
# string. That is why the two secrets below fail the boot rather than passing as
# empty, and why a numeric variable left blank falls back to its default instead
# of silently becoming 0.

NODE_ENV=development
PORT=3000

# Postgres is published on 5433, not 5432. The compose file avoids a clash with
# the container from week 1.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/tshirt_store
REDIS_URL=redis://localhost:6379

JWT_SECRET=
REFRESH_TOKEN_PEPPER=

# Seconds. 900 is 15 minutes, 604800 is 7 days.
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
REFRESH_ABSOLUTE_TTL_DAYS=30

# How long the token a rotation replaced keeps working, so two browser tabs
# refreshing at the same moment do not look like a stolen token. Every second of
# this window is a second in which a stolen previous token is accepted without
# raising the alarm. 0 turns it off.
REFRESH_GRACE_SECONDS=10

# The browser origins allowed to call this API, comma separated. Empty means no
# cross-origin browser may call it, which is the right answer with no front end.
#   CORS_ORIGINS=http://localhost:5173,https://shop.example
CORS_ORIGINS=

# How many reverse proxies sit in front of this process. The rate limit is keyed
# on the caller's address, and with nothing set that address is the proxy's, so
# every caller shares one counter. A count and never `true`: trusting every hop
# lets any client forge `X-Forwarded-For` and evade the limit outright.
# 0 is correct with nothing in front, which is the case locally.
TRUST_PROXY_HOPS=0

# Seconds here. The throttler reads milliseconds, so the module wraps this value
# in its own `seconds()` helper rather than passing it through.
#
# THROTTLE_LIMIT is the browse tier, and it is deliberately loose. Sign-in and the
# three password operations carry their own tighter limits through `@Throttle`,
# so lowering this number does not tighten them.
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Mailpit, from the compose file. Its web interface is on 8025.
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@tshirt.store

# Where a password reset link points. The mailer builds every reset URL against
# this value.
APP_URL=http://localhost:3000
