# Working local values. `cp .env.example .env` boots against `npm run docker:up`.
# Four blank keys need a value: JWT_SECRET and REFRESH_TOKEN_PEPPER (32
# characters or more), STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET (from
# Stripe). The other four blanks stay blank on a laptop. A blank value reads as
# absent, never as 0.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

NODE_ENV=development
PORT=3000

# The lowest log level that reaches stdout: fatal, error, warn, info, debug,
# trace, or silent. Every line is JSON, one per event. In development the lines
# are pretty-printed instead.
LOG_LEVEL=info

# Postgres is published on 5433, not 5432, so it cannot clash with another
# local Postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/tshirt_store
# The certificate bundle the database connection is verified against. Blank on
# a laptop, because the compose container speaks no TLS. The deployed task sets
# it to the RDS bundle the image carries, since RDS refuses plaintext.
DATABASE_SSL_CA=
# Connections each process opens to Postgres. The API and the worker are two
# processes per task, and `ARCHITECTURE.md` counts the ceiling from the measured
# `max_connections`. 10 is the driver's own default, chosen here on purpose.
DATABASE_POOL_SIZE=10
# Product images: the bucket they are stored in and the address they are served
# from, both stack outputs (`ImagesBucket`, `ApiUrl`). The two values below are
# placeholders, because the validator wants a value and not a working bucket, so
# the API boots with no AWS account. Only an image upload needs the outputs, and
# an upload against a placeholder fails at S3 with a 500, never at boot. The
# SDK's credentials come from the shell on a laptop,
# `AWS_PROFILE=tshirt npm run start:dev`, and from the task role in the
# container; nothing in this file carries them.
S3_BUCKET=local-only-bucket
IMAGES_BASE_URL=http://localhost:3000
AWS_REGION=us-east-2
# Required. The stock notification queue opens it at boot, and the compose
# file's Redis answers on 6379.
REDIS_URL=redis://localhost:6379

JWT_SECRET=
REFRESH_TOKEN_PEPPER=

# Seconds. 900 is 15 minutes, 604800 is 7 days.
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
REFRESH_ABSOLUTE_TTL_DAYS=30

# How long the token a rotation replaced keeps working, so two browser tabs
# refreshing at the same moment do not look like a stolen token. Every second of
# this window is a second in which a stolen previous token is accepted without
# raising the alarm. 0 turns it off.
REFRESH_GRACE_SECONDS=10

# The browser origins allowed to call this API, comma separated. Empty means no
# cross-origin browser may call it, which is the right answer with no front end.
#   CORS_ORIGINS=http://localhost:5173,https://shop.example
CORS_ORIGINS=

# How many reverse proxies sit in front of this process. The rate limit is keyed
# on the caller's address, and with nothing set that address is the proxy's, so
# every caller shares one counter. A count and never `true`: trusting every hop
# lets any client forge `X-Forwarded-For` and evade the limit outright.
# 0 is correct with nothing in front, which is the case locally.
TRUST_PROXY_HOPS=0

# Seconds here. The throttler reads milliseconds, so the module wraps this value
# in its own `seconds()` helper rather than passing it through.
#
# THROTTLE_LIMIT is the browse tier, and it is deliberately loose. Sign-in,
# sign-up, refresh and the three password operations carry their own tighter
# limits through `@Throttle`, so lowering this number does not tighten them.
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# How mail leaves the process. `smtp` reads the SMTP_* lines below, which is
# Mailpit here. `ses` sends through Amazon SES in AWS_REGION with the
# credentials of the environment, the task role in the container, and needs no
# relay at all. The deployed stack sets it; a laptop keeps smtp.
MAIL_TRANSPORT=smtp

# Mailpit, from the compose file. Its web interface is on 8025.
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@tshirt.store

# Whether the connection to the relay is TLS from the first byte. That is right
# for a relay on port 465 and wrong for one on 587 or 25: those speak plaintext
# first and upgrade with STARTTLS, and true against them fails every send.
# Mailpit speaks no TLS, so false is right on a laptop.
#
# Write the word. `true`, `false`, `1` and `0` are the only values a boolean
# reads, and any other value stops the boot instead of quietly becoming true.
SMTP_SECURE=false

# Whether a relay that offers no STARTTLS is refused. With SMTP_SECURE false the
# mailer upgrades when the relay offers STARTTLS and sends in the clear when it
# does not, which is also what a downgraded connection looks like. Set it true
# for any 587 relay that is not on the laptop: the reset message carries a token
# that signs the account in. Mailpit offers no STARTTLS, so false here.
SMTP_REQUIRE_TLS=false

# The relay credentials. Both blank means no authentication, which is Mailpit.
# Set both or set neither, because one alone is ignored.
SMTP_USER=
SMTP_PASS=

# Where a password reset link points. The mailer builds every reset URL against
# this value.
APP_URL=http://localhost:3000

# Stripe. The secret key is a test-mode key from the dashboard, sk_test_...
# The webhook secret is what `stripe listen --forward-to
# localhost:3000/v1/webhooks/stripe` prints, whsec_..., and every event the
# server applies is verified against it first. Both are required: without them
# the boot refuses, because an unverified event could mark an order paid.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
