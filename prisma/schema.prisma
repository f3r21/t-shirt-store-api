// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]

  @@map("roles")
}

model User {
  id                  Int       @id @default(autoincrement())
  email               String    @unique
  passwordHash        String    @map("password_hash")
  firstName           String    @map("first_name")
  lastName            String    @map("last_name")
  roleId              Int       @map("role_id")
  resetTokenHash      String?   @unique @map("reset_token_hash")
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  role Role @relation(fields: [roleId], references: [id])

  refreshTokens RefreshToken[]
  orders        Order[]
  cartItems     CartItem[]

  @@map("users")
}

model RefreshToken {
  id                Int      @id @default(autoincrement())
  userId            Int      @map("user_id")
  tokenHash         String   @unique @map("token_hash")
  previousTokenHash String?  @map("previous_token_hash")
  deviceName        String?  @map("device_name")
  expiresAt         DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Every rotation looks a presented token up by previous_token_hash, and
  // listSessions filters by user_id. Prisma indexes no foreign key on its own,
  // and the auth migration created neither.
  @@index([userId])
  @@index([previousTokenHash])
  @@map("refresh_tokens")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Soft delete lives on this table alone. deleteProduct sets the column and
  // keeps the row, because order history points at the variants of a product
  // that may since have been withdrawn.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  variants   ProductVariant[]
  categories ProductCategory[]
  orderItems OrderItem[]

  // No index beyond the primary key, and no unique on `name`. createProduct
  // declares 400, 401, 403, 422 and 500 and no 409, so a repeated name is
  // legal. `deleted_at IS NULL` matches nearly every row and `is_active` holds
  // two values, so the planner would decline an index on either.
  @@map("products")
}

model ProductVariant {
  id        Int @id @default(autoincrement())
  productId Int @map("product_id")

  // The empty string is the stored spelling of "this variant has no size".
  // PostgreSQL treats two NULLs in a unique index as distinct and Prisma 7.10
  // cannot ask for NULLS NOT DISTINCT, so nullable columns would admit exactly
  // the duplicate pair the contract answers with a 409. The mapper drops the
  // empty string again on the way out, so the wire still shows absence.
  size  String @default("")
  color String @default("")

  // Minor units, so 1999 means 19.99. Not numeric(10,2), which is what the ERD
  // says: an integer needs no conversion inbound, outbound, or at Stripe, and
  // Prisma hands a numeric back as a Decimal instance that serialises to a
  // string. This is a deliberate departure from the ERD, recorded in
  // DECISIONS.md.
  priceCents Int @map("price_cents")

  // No default on purpose. Prisma makes a defaulted field optional in the
  // create input, and the contract makes stock required on createVariant, so
  // the absence of a default is what turns a forgotten value into a type error.
  stock Int

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  // One index doing two jobs: it enforces the 409 on createVariant and
  // updateVariant, and its leading column serves both the variants of one
  // product and the `productId IN (...)` lookup behind priceFrom. A second
  // @@index([productId]) would index the same leading column twice and slow
  // every insert for nothing.
  @@unique([productId, size, color])
  @@map("product_variants")
}

model Category {
  id Int @id @default(autoincrement())

  // Unique so the seed can upsert on the name, the way the three role rows
  // already do.
  name String @unique

  products ProductCategory[]

  @@map("categories")
}

model ProductCategory {
  productId  Int @map("product_id")
  categoryId Int @map("category_id")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // An explicit model rather than an implicit many-to-many, which would create
  // a table named _CategoryToProduct with columns A and B, against both the ERD
  // and this schema's rule that every model carries @@map.
  //
  // The composite key serves every product-first read. The categoryId filter on
  // listProducts drives from the other side, and nothing leads with category_id
  // without the second index.
  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

enum OrderStatus {
  pending
  paid
  processing
  shipped
  delivered
  cancelled

  // The six members the ERD declares, in the lower case the contract uses.
  // `paid` and `delivered` ship although no operation in scope writes either:
  // the payment webhook sets `paid`, and `delivered` belongs to the delivery
  // feature. The enum is the domain, not the list of legal moves.
  @@map("order_status")
}

model CartItem {
  userId    Int @map("user_id")
  variantId Int @map("product_variant_id")
  quantity  Int

  // The only timestamp here, and it has a reader: this table has no id, so the
  // cart's order needs a stable second key, and "the order the user added
  // things in" is the one a user would not find arbitrary.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // No cart table and no surrogate id. The cart response carries items and a
  // subtotal and nothing else, so no caller can observe a cart row, and "the
  // cart exists because the user exists" becomes a fact about this key rather
  // than a row that an upsert has to create first. This departs from the ERD's
  // shopping_carts table, and the primary key is the stronger guarantee.
  //
  // One key, four operations: the list and the clear read the user_id prefix,
  // the set upserts on the pair, the delete removes it.
  @@id([userId, variantId])
  @@map("cart_items")
}

model Order {
  id     Int @id @default(autoincrement())
  userId Int @map("user_id")

  // A stored column rather than the last history row. Status is a filter on
  // both list operations, and deriving it would make the commonest filter a
  // correlated subquery on every page. No default, so createOrder has to say
  // `pending` out loud.
  status OrderStatus

  // Minor units, for the reason recorded against price_cents. Both columns are
  // real rather than one aliasing the other: the history filters on the total,
  // so they diverge the day a discount exists.
  subtotalCents Int @map("subtotal_cents")
  totalCents    Int @map("total_cents")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // No updatedAt, unlike products. The status history records every mutation
  // with its own timestamp, so the column would be a second, lossier copy.

  user          User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  statusHistory OrderStatusChange[]

  // The client's own history, and a manager filtering by one client. The
  // equality that is always present leads, then the range that is also the sort
  // key, then the tiebreak. A btree scans backwards for free, so this ascending
  // index serves a newest-first page with no sort step.
  @@index([userId, createdAt, id])
  // A manager's unfiltered page. No leading equality, so the composite above
  // cannot serve it.
  @@index([createdAt, id])
  @@map("orders")
}

model OrderItem {
  orderId   Int @map("order_id")
  variantId Int @map("product_variant_id")

  // Not a snapshot. A variant never moves between products, because the update
  // operation accepts size, colour and price only. It is here so reading an
  // order touches order_items alone.
  productId Int @map("product_id")

  // The four snapshots, copied when the order is placed and never read back
  // from the catalog. A rename or a reprice must not rewrite history.
  productName    String @map("product_name")
  size           String
  color          String
  unitPriceCents Int    @map("unit_price_cents")

  quantity Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  // No surrogate id: an order line carries none on the wire, and the cart
  // guarantees one line per variant.
  @@id([orderId, variantId])
  // Two jobs: counting the lines on a variant before deleting it, and giving
  // RESTRICT an index to check rather than a sequential scan.
  @@index([variantId])
  @@map("order_items")
}

model OrderStatusChange {
  id        Int         @id @default(autoincrement())
  orderId   Int         @map("order_id")
  status    OrderStatus
  changedAt DateTime    @default(now()) @map("changed_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // One order's history, oldest first. Equality then sort key. The id tiebreak
  // stays in the query rather than the index, because two rows written in one
  // transaction share an instant.
  @@index([orderId, changedAt])
  @@map("order_status_history")
}
