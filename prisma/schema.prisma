generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]

  @@map("roles")
}

model User {
  id                  Int       @id @default(autoincrement())
  email               String    @unique @db.Citext
  passwordHash        String    @map("password_hash")
  firstName           String    @map("first_name")
  lastName            String    @map("last_name")
  roleId              Int       @map("role_id")
  resetTokenHash      String?   @unique @map("reset_token_hash")
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  role Role @relation(fields: [roleId], references: [id])

  refreshTokens  RefreshToken[]
  consumedTokens ConsumedRefreshToken[]
  likes          ProductLike[]
  stockAlerts   StockNotification[]
  orders        Order[]
  cartItems     CartItem[]

  // The orders this user delivered, which is the delivery person's own history.
  // Named, because `orders` above already relates the two models and Prisma
  // cannot tell two relations between one pair apart without a name.
  deliveries    Order[]             @relation("OrderDeliveredBy")

  @@map("users")
}

model RefreshToken {
  id                Int      @id @default(autoincrement())
  userId            Int      @map("user_id")
  tokenHash         String   @unique @map("token_hash")
  previousTokenHash String?  @map("previous_token_hash")
  deviceName        String?  @map("device_name")
  expiresAt         DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // When the row last rotated: the grace window is measured from it. `created_at`
  // is the start of the device session and `expires_at` is rewritten on every
  // rotation, so neither can carry it. Nullable so the migration is additive; a
  // row that never rotated is inside no window. See ADR 2.
  rotatedAt         DateTime? @map("rotated_at") @db.Timestamptz(6)

  // The device session this row belongs to, named by the id of the row that
  // started it. A device is a family, so two tabs refreshing in the same moment
  // each hold a live token. An `Int`, because `sid` in the access token is a
  // `number` (`access-token-payload.ts`) and the session id must not change.
  // Null means the row is its own founder: a row cannot reference its own id on
  // insert, and every row written before families reads as its own family, so
  // the migration needs no backfill. `AuthService.familyOf` and `familyWhere`
  // encode the rule. See ADR 2.
  familyId          Int?      @map("family_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // `listSessions` filters by user_id and groups by family_id, and every delete
  // of a session names a family. Prisma indexes no foreign key on its own, and
  // the auth migration created neither.
  //
  // `previous_token_hash` keeps its index because the column is still here. It
  // is dead: `consumed_refresh_tokens` replaced it as the memory of which
  // tokens have been spent, because one column can only remember one
  // generation and cannot remember when. Both come out together in a later
  // release, with expand and contract.
  @@index([userId])
  @@index([familyId])
  @@index([previousTokenHash])
  @@map("refresh_tokens")
}

/**
 * Every refresh token this server has already spent. One column on the token
 * row could not say both which token the grace window still accepts and which
 * tokens must raise the alarm, so a spent token is a row here, written once.
 * `consumed_at` is what the grace window is measured against. `user_id` is
 * stored because the reuse response deletes every row for the user, and the
 * family's rows may be gone by then. Nothing prunes it yet: a sweep of rows
 * older than the absolute session cap is safe, and is the first thing to add.
 * See ADR 3.
 */
model ConsumedRefreshToken {
  tokenHash  String   @id @map("token_hash")
  familyId   Int      @map("family_id")
  userId     Int      @map("user_id")
  consumedAt DateTime @default(now()) @map("consumed_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("consumed_refresh_tokens")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Soft delete lives on this table alone. deleteProduct sets the column and
  // keeps the row, because order history points at the variants of a product
  // that may since have been withdrawn.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  variants   ProductVariant[]
  categories ProductCategory[]
  images     ProductImage[]
  orderItems OrderItem[]

  // No index beyond the primary key, and no unique on `name`. createProduct
  // declares 400, 401, 403, 422 and 500 and no 409, so a repeated name is
  // legal. `deleted_at IS NULL` matches nearly every row and `is_active` holds
  // two values, so the planner would decline an index on either.
  @@map("products")
}

model ProductVariant {
  id        Int @id @default(autoincrement())
  productId Int @map("product_id")

  // The empty string is the stored spelling of "this variant has no size".
  // PostgreSQL treats two NULLs in a unique index as distinct and Prisma 7.10
  // cannot ask for NULLS NOT DISTINCT, so nullable columns would admit exactly
  // the duplicate pair the contract answers with a 409. The mapper drops the
  // empty string again on the way out, so the wire still shows absence.
  size  String @default("")
  color String @default("")

  // Minor units, so 1999 means 19.99. Not numeric(10,2), which is what the ERD
  // says: an integer needs no conversion inbound, outbound, or at Stripe, and
  // Prisma hands a numeric back as a Decimal instance that serialises to a
  // string. ADR 13 records the departure from the ERD.
  priceCents Int @map("price_cents")

  // No default: Prisma makes a defaulted field optional in the
  // create input, and the contract makes stock required on createVariant, so
  // the absence of a default is what turns a forgotten value into a type error.
  stock Int

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems   CartItem[]
  orderItems  OrderItem[]
  likes       ProductLike[]
  stockAlerts StockNotification[]

  // One index doing two jobs: it enforces the 409 on createVariant and
  // updateVariant, and its leading column serves both the variants of one
  // product and the `productId IN (...)` lookup behind priceFrom. A second
  // @@index([productId]) would index the same leading column twice and slow
  // every insert for nothing.
  @@unique([productId, size, color])
  @@map("product_variants")
}

model Category {
  id Int @id @default(autoincrement())

  // Unique so the seed can upsert on the name, the way the three role rows
  // already do.
  name String @unique

  products ProductCategory[]

  @@map("categories")
}

model ProductCategory {
  productId  Int @map("product_id")
  categoryId Int @map("category_id")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // An explicit model rather than an implicit many-to-many, which would create
  // a table named _CategoryToProduct with columns A and B, against both the ERD
  // and this schema's rule that every model carries @@map.
  //
  // The composite key serves every product-first read. The categoryId filter on
  // listProducts drives from the other side, and nothing leads with category_id
  // without the second index.
  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

enum OrderStatus {
  pending
  paid
  processing
  shipped
  delivered
  cancelled

  // The six members the ERD declares, in the lower case the contract uses.
  // `paid` is the payment webhook's alone, and a delivery person or a manager
  // writes `delivered` through `setOrderStatus`. The enum is the domain, not
  // the list of legal moves: `order-status.ts` holds those.
  @@map("order_status")
}

/// The Stripe flow that paid an order: a payment link buys one product, a
/// payment intent buys a cart. Absent until a payment succeeds, so the column
/// on `Order` is nullable.
enum PaymentMethod {
  payment_link
  payment_intent

  @@map("payment_method")
}

model CartItem {
  userId    Int @map("user_id")
  variantId Int @map("product_variant_id")
  quantity  Int

  // The only timestamp here, and it has a reader: this table has no id, so the
  // cart's order needs a stable second key, and "the order the user added
  // things in" is the one a user would not find arbitrary.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // No cart table and no surrogate id. The cart response carries items and a
  // subtotal and nothing else, so no caller can observe a cart row, and "the
  // cart exists because the user exists" becomes a fact about this key rather
  // than a row that an upsert has to create first. This departs from the ERD's
  // shopping_carts table, and the primary key is the stronger guarantee.
  //
  // One key, four operations: the list and the clear read the user_id prefix,
  // the set upserts on the pair, the delete removes it.
  @@id([userId, variantId])
  @@map("cart_items")
}

model Order {
  id     Int @id @default(autoincrement())
  userId Int @map("user_id")

  // A stored column, not derived from the last history row: status is a filter
  // on both list operations, and deriving it would make the commonest filter a
  // correlated subquery on every page. No default, so createOrder has to say
  // `pending`.
  status OrderStatus

  // Minor units, for the reason recorded against price_cents. Two real columns:
  // the history filters on the total, and the two diverge once a discount exists.
  subtotalCents Int @map("subtotal_cents")
  totalCents    Int @map("total_cents")

  // The promo code this order used. Three columns for one fact, and each carries
  // a different part of it. See ADR 37.
  //
  // The foreign key points at the row `used_count` counts, so the count and the
  // orders behind it cannot drift apart. Null when the order used no code.
  promoCodeId Int? @map("promo_code_id")

  // The code as the manager typed it, copied at checkout the way
  // `unit_price_cents` copies a price. An order is a fixed record, so renaming a
  // code later must not rewrite the history of the orders that used the old name.
  promoCode String? @map("promo_code")

  // What the code took off the subtotal, in minor units. Zero and not null when
  // there is no code, because the contract makes `discount` a required member and
  // every order has an answer for it: nothing came off.
  discountCents Int @default(0) @map("discount_cents")

  // Nullable because the contract says so: absent until a payment succeeds. The
  // webhook is the only writer, at the moment it moves the status to `paid`.
  // The ERD's `order_payments` table is not here: the contract exposes one field
  // of it, and the Stripe reference it carried lives on `StripeEvent`, where
  // idempotency needs it. See ADR 24.
  paymentMethod PaymentMethod? @map("payment_method")

  // Who moved this order to `delivered`. Null until that happens, so the
  // migration is additive and no order needs a backfill. One column rather than
  // an assignment table, because an order is delivered once and nothing in the
  // brief dispatches an order before it ships. See ADR 36.
  deliveredById Int? @map("delivered_by_user_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // No updatedAt, unlike products. The status history records every mutation
  // with its own timestamp, so the column would be a second, lossier copy.

  user          User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  statusHistory OrderStatusChange[]

  // SET NULL and not RESTRICT, unlike `user` above: the order is the record and
  // the delivery person is an attribution on it, so removing an account must not
  // hold an order hostage. The row keeps its `delivered` status either way.
  deliveredBy   User?               @relation("OrderDeliveredBy", fields: [deliveredById], references: [id], onDelete: SetNull)

  // RESTRICT and not SET NULL, the opposite of `deliveredBy` above: `used_count`
  // counts the orders that point here, so a deleted code would leave that number
  // describing rows nothing references. No operation deletes a code, because a
  // manager disables one instead, and the constraint is what makes that hold for
  // a hand-written statement too. `promoCodeRow` and not `promoCode`, which is
  // the snapshot column above.
  //
  // No index on the foreign key. Nothing reads an order by its code, and the only
  // lookup RESTRICT runs is on a delete this API never performs.
  promoCodeRow  PromoCode?          @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)

  // The client's own history, and a manager filtering by one client. The
  // equality that is always present leads, then the range that is also the sort
  // key, then the tiebreak. A btree scans backwards for free, so this ascending
  // index serves a newest-first page with no sort step.
  @@index([userId, createdAt, id])
  // A manager's unfiltered page. No leading equality, so the composite above
  // cannot serve it. It also serves the delivery queue, which filters on
  // `status` and names no user.
  @@index([createdAt, id])
  // One delivery person's history, in the shape of the first index: the column
  // the filter always names leads, then the sort key, then the tiebreak. It is
  // also the lookup `ON DELETE SET NULL` runs when an account is deleted.
  @@index([deliveredById, createdAt, id])
  @@map("orders")
}

model OrderItem {
  orderId   Int @map("order_id")
  variantId Int @map("product_variant_id")

  // Not a snapshot. A variant never moves between products, because the update
  // operation accepts size, colour and price only. It is here so reading an
  // order touches order_items alone.
  productId Int @map("product_id")

  // The four snapshots, copied when the order is placed and never read back
  // from the catalog. A rename or a reprice must not rewrite history.
  productName    String @map("product_name")
  size           String
  color          String
  unitPriceCents Int    @map("unit_price_cents")

  quantity Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  // No surrogate id: an order line carries none on the wire, and the cart
  // guarantees one line per variant.
  @@id([orderId, variantId])
  // Two jobs: counting the lines on a variant before deleting it, and giving
  // RESTRICT an index to check rather than a sequential scan.
  @@index([variantId])
  @@map("order_items")
}

model OrderStatusChange {
  id        Int         @id @default(autoincrement())
  orderId   Int         @map("order_id")
  status    OrderStatus
  changedAt DateTime    @default(now()) @map("changed_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // One order's history, oldest first. Equality then sort key. The id tiebreak
  // stays in the query rather than the index, because two rows written in one
  // transaction share an instant.
  @@index([orderId, changedAt])
  @@map("order_status_history")
}

/// A user's like on one variant. See the contract's `likeVariant`.
///
/// Keyed on the variant and not the product: a like says "tell me when this
/// size in this colour runs low", and a product-level like cannot answer it.
///
/// No surrogate id and no timestamp. The pair is the whole fact, the contract
/// exposes neither, and `PUT` and `DELETE` on the like are idempotent because
/// the primary key makes them so.
model ProductLike {
  userId    Int @map("user_id")
  variantId Int @map("product_variant_id")

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([userId, variantId])
  // The queue reads this table the other way round: when stock reaches three it
  // needs every user who liked one variant. The primary key leads on `user_id`,
  // so it serves `GET /users/me/likes` and cannot serve that. This index is the
  // stock notification producer's only lookup.
  @@index([variantId])
  @@map("product_likes")
}

/// One image of a product. See the contract's `ProductImage`.
///
/// `url` holds the public address, not the object key. The API returns it
/// verbatim and never signs it, because the contract's example is a plain CDN
/// address and a signed URL would expire inside a cached response.
model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  url       String
  isPrimary Boolean @default(false) @map("is_primary")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Every read of this table is "the images of one product", as an include on
  // the product detail. Nothing lists images across products.
  @@index([productId])
  @@map("product_images")
}

/// One Stripe event this server has already applied. Stripe retries a non-2xx
/// for up to three days, so the row is inserted inside the transaction that
/// moves the order to `paid`, and a retry is a unique violation the handler
/// answers 200 to. The id is Stripe's own event id: that is the identity being
/// made unique. See ADR 24.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@map("stripe_events")
}

/// One low-stock mail already sent. Stock oscillating around the threshold
/// would mail the same person on every crossing, so the row is written before
/// the mail and the database arbitrates the race. The key means one mail per
/// user and variant, ever: a restock months later sends nothing. See ADR 28.
model StockNotification {
  userId    Int      @map("user_id")
  variantId Int      @map("product_variant_id")
  sentAt    DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([userId, variantId])
  @@map("stock_notifications")
}

/// How a promo code reduces a subtotal: a share of it, or a flat amount off it.
/// The member decides how `discount_value` reads, so the two live in one row
/// rather than in two nullable columns.
enum PromoDiscountType {
  percentage
  fixed

  @@map("promo_discount_type")
}

/// One discount code a manager created. Optional Feature 13.
///
/// The table is the whole feature on the manager's side: a code is created,
/// listed and switched between active and inactive, and no row is ever deleted,
/// because an order that used a code points at it.
model PromoCode {
  id Int @id @default(autoincrement())

  /// Stored as the manager typed it and compared without case, which is what
  /// `citext` gives. `SAVE10` and `save10` are one code, so the unique index
  /// answers the 409 on both spellings and a client may send either. The same
  /// column type the `users.email` column uses, for the same reason.
  code String @unique @db.Citext

  discountType PromoDiscountType @map("discount_type")

  /// A percentage from 1 to 100, or an amount in minor units. `discount_type`
  /// decides which, and the DTO bounds the percentage at 100. Minor units for
  /// the reason `price_cents` records.
  discountValue Int @map("discount_value")

  /// When the server stops accepting the code. Null means the code does not
  /// expire, which is the state a code is created in unless the manager names
  /// a date.
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)

  /// How many orders may use the code in total. Null means no limit. The pair
  /// with `used_count` is what checkout compares.
  usageLimit Int? @map("usage_limit")

  /// How many orders have used the code. Checkout is the only writer, and it
  /// increments the value inside the transaction that creates the order.
  usedCount Int @default(0) @map("used_count")

  /// The smallest subtotal the code applies to, in minor units. Null means the
  /// code applies to any subtotal.
  minPurchaseCents Int? @map("min_purchase_cents")

  /// The disable and enable switch the brief asks for. A disabled code stays in
  /// the list and stays on the orders that already used it.
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// The orders that used this code. `ON DELETE RESTRICT` on the other side, so
  /// a code that any order used cannot be deleted while `used_count` counts it.
  orders Order[]

  /// No `updatedAt`, and no index beyond the unique on `code`. That index is
  /// what the 409 rests on and what checkout looks a code up by. The list sorts
  /// on `created_at`, and a store holds a few dozen codes, so an index for the
  /// sort would cost every insert and save one sequential scan of one page.
  @@map("promo_codes")
}
